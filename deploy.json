{
  "schemaVersion": 1,
  "appId": "food",
  "imageRepository": "ghcr.io/hurdoo/food",
  "displayName": "은혜 갚는 호랑이",
  "description": "밥약 감사 스토리에 붙이는 선배 헌정관",
  "containerPort": 3000,
  "healthPath": "/healthz",
  "access": "private",
  "dataEnabled": true,
  "resources": {
    "memoryMiB": 256,
    "cpus": 1,
    "pids": 64
  },
  "ingressProfile": "standard",
  "environment": {},
  "requiredSecrets": ["ADMIN_PASSWORD"],
  "optionalSecrets": [],
  "platform": "linux/arm64",
  "dockerfile": "Dockerfile",
  "context": ".",
  "checks": [["pnpm", "check"]]
}
