{
  "name": "food",
  "private": true,
  "version": "0.1.0",
  "description": "밥약 고마움을 전하는 손수 만든 페이지들 (은혜 갚는 호랑이)",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "page": "node scripts/page.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
